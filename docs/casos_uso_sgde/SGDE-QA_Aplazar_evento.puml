@startuml SGDE-QA_Aplazar_evento
!pragma layout smetana
left to right direction
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #F2F2F2
  BorderColor black
  FontSize 12
}
skinparam rectangle {
  BorderColor black
  FontSize 13
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #B8A86B
  FontSize 11
}
skinparam ArrowColor black
skinparam actorStyle awesome
title Aplazar evento (hallazgo de QA)

actor "Administrador" as AD

rectangle "SGDE" {
  usecase "Aplazar evento\na otra fecha" as UC1
  usecase "Verificar que la fecha\nnueva esté libre" as UC2
  usecase "Registrar movimiento" as UC3
}

AD -- UC1
UC1 ..> UC2 : <<include>>
UC1 ..> UC3 : <<include>>

note right of UC1
  Solo una bloqueada o confirmada;
  una cotizada se cambia con Editar (409).
  Pide la fecha nueva (futura y distinta)
  y el motivo. Salón, montaje, conceptos
  y garantía no cambian. En una bloqueada
  el bloqueo no puede terminar después
  del día nuevo.
end note
note right of UC2
  409 si otra cotización está confirmada
  o bloqueada ese día en ese salón.
end note
@enduml
