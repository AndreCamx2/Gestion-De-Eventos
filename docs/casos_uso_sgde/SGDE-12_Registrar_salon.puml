@startuml SGDE-12_Registrar_salon
!pragma layout smetana
left to right direction
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #F2F2F2
  BorderColor black
  FontSize 12
}
skinparam rectangle {
  BorderColor black
  FontSize 13
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #B8A86B
  FontSize 11
}
skinparam ArrowColor black
skinparam actorStyle awesome
title SGDE-12 · Registrar salón (RF-02)

actor "Administrador" as AD

rectangle "SGDE" {
  usecase "Registrar salón" as UC1
  usecase "Editar salón" as UC2
  usecase "Dar de baja salón\n(SGDE-99)" as UC3
  usecase "Verificar que no tenga\ncotizaciones activas" as UC4
}

AD --> UC1
AD --> UC2
AD --> UC3
UC3 ..> UC4 : <<include>>

note right of UC1
  Nombre, alto, ancho y foto (URL) en uno
  de los sitios del administrador.
end note
note right of UC4
  Si tiene cotizaciones activas
  responde 409 y no lo da de baja.
end note
@enduml
