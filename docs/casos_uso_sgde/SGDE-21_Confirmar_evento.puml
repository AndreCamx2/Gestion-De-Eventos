@startuml SGDE-21_Confirmar_evento
!pragma layout smetana
left to right direction
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #F2F2F2
  BorderColor black
  FontSize 12
}
skinparam rectangle {
  BorderColor black
  FontSize 13
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #B8A86B
  FontSize 11
}
skinparam ArrowColor black
skinparam actorStyle awesome
title SGDE-21 · Confirmar evento (RF-09)

actor "Administrador" as AD

rectangle "SGDE" {
  usecase "Registrar aceptación\ny garantía" as UC1
  usecase "Confirmar evento" as UC2
  usecase "Verificar que la fecha\nesté libre" as UC3
  usecase "Registrar movimiento" as UC4
}

AD --> UC1
UC1 ..> UC2 : <<include>>
UC2 ..> UC3 : <<include>>
UC2 ..> UC4 : <<include>>

note bottom of UC2
  Confirmar no es un paso aparte: registrar la garantía
  confirma. La base de datos impide dos confirmadas en el
  mismo salón y fecha (409 si otra ganó primero).
end note
@enduml
