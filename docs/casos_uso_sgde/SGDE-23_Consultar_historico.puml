@startuml SGDE-23_Consultar_historico
!pragma layout smetana
left to right direction
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #F2F2F2
  BorderColor black
  FontSize 12
}
skinparam rectangle {
  BorderColor black
  FontSize 13
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #B8A86B
  FontSize 11
}
skinparam ArrowColor black
skinparam actorStyle awesome
title SGDE-23 · Consultar histórico (RF-11)

actor "Administrador" as AD

rectangle "SGDE" {
  usecase "Consultar histórico\nde cotizaciones" as UC1
  usecase "Filtrar por estado, cliente\ny rango de fechas" as UC2
  usecase "Ver movimientos de una\ncotización (SGDE-62)" as UC3
}

AD --> UC1
UC2 .> UC1 : <<extend>>
UC3 .> UC1 : <<extend>>

note right of UC3
  Quién hizo cada cambio y cuándo.
  Usuario vacío = lo hizo el sistema.
end note
@enduml
