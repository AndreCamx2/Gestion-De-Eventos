@startuml SGDE-11_Registrar_empresas
!pragma layout smetana
left to right direction
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #F2F2F2
  BorderColor black
  FontSize 12
}
skinparam rectangle {
  BorderColor black
  FontSize 13
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #B8A86B
  FontSize 11
}
skinparam ArrowColor black
skinparam actorStyle awesome
title SGDE-11 · Registrar empresas

actor "Administrador" as AD

rectangle "SGDE" {
  usecase "Registrar empresa" as UC1
  usecase "Consultar empresas" as UC2
  usecase "Buscar por razón social\no identificación" as UC3
}

AD --> UC1
AD --> UC2
UC3 .> UC2 : <<extend>>

note right of UC1
  La identificación (NIT) es única.
  Las empresas se comparten entre sitios.
end note
@enduml
