@startuml SGDE-29_Registrar_sitio
!pragma layout smetana
left to right direction
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #F2F2F2
  BorderColor black
  FontSize 12
}
skinparam rectangle {
  BorderColor black
  FontSize 13
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #B8A86B
  FontSize 11
}
skinparam ArrowColor black
skinparam actorStyle awesome
title SGDE-29 · Registrar sitio

actor "Administrador" as AD

rectangle "SGDE" {
  usecase "Registrar sitio" as UC1
  usecase "Consultar mis sitios" as UC2
  usecase "Asignarme el sitio" as UC3
}

AD --> UC1
AD --> UC2
UC1 ..> UC3 : <<include>>

note right of UC1
  Un sitio es un hotel, centro de convenciones,
  finca o casa de eventos. Tiene nombre y ciudad.
end note
@enduml
