@startuml SGDE-14_Consultar_disponibilidad
!pragma layout smetana
left to right direction
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #F2F2F2
  BorderColor black
  FontSize 12
}
skinparam rectangle {
  BorderColor black
  FontSize 13
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #B8A86B
  FontSize 11
}
skinparam ArrowColor black
skinparam actorStyle awesome
title SGDE-14 · Consultar disponibilidad (RF-04)

actor "Administrador" as AD

rectangle "SGDE" {
  usecase "Consultar calendario\nde un salón (SGDE-45)" as UC1
  usecase "Ver rack de salones\npor día (SGDE-69)" as UC2
  usecase "Ver el día de un salón" as UC3
  usecase "Bloquear salón" as UC4
  usecase "Liberar bloqueo" as UC5
}

AD --> UC1
AD --> UC2
UC3 .> UC1 : <<extend>>
UC3 .> UC2 : <<extend>>
UC4 .> UC3 : <<extend>>
UC5 .> UC3 : <<extend>>

note right of UC2
  Colores por estado: cotizado, bloqueado,
  confirmado y vencida. Las canceladas
  no se muestran.
end note
@enduml
