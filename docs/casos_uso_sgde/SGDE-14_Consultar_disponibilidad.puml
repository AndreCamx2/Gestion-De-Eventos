@startuml SGDE-14_Consultar_disponibilidad
!pragma layout smetana
left to right direction
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #F2F2F2
  BorderColor black
  FontSize 12
}
skinparam rectangle {
  BorderColor black
  FontSize 13
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #B8A86B
  FontSize 11
}
skinparam ArrowColor black
skinparam actorStyle awesome
title SGDE-14 · Consultar disponibilidad (RF-04)

actor "Administrador" as AD

rectangle "SGDE" {
  usecase "Consultar calendario\nde un salón (SGDE-45)" as UC1
  usecase "Ver rack de salones\npor día (SGDE-69)" as UC2
  usecase "Ver el día de un salón" as UC3
  usecase "Bloquear salón" as UC4
  usecase "Liberar bloqueo" as UC5
}

AD -- UC1
AD -- UC2
UC1 <.. UC3 : <<extend>>
UC2 <.. UC3 : <<extend>>
UC3 <.. UC4 : <<extend>>
UC3 <.. UC5 : <<extend>>

note right of UC2
  Colores por estado: disponible, cotizado,
  bloqueado y confirmado. Las vencidas y
  las canceladas no ocupan la fecha; las
  vencidas solo se listan en el día del
  calendario.
end note
@enduml
