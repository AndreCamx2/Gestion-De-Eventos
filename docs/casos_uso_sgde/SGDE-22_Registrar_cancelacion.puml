@startuml SGDE-22_Registrar_cancelacion
!pragma layout smetana
left to right direction
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #F2F2F2
  BorderColor black
  FontSize 12
}
skinparam rectangle {
  BorderColor black
  FontSize 13
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #B8A86B
  FontSize 11
}
skinparam ArrowColor black
skinparam actorStyle awesome
title SGDE-22 · Registrar cancelación (RF-10)

actor "Administrador" as AD

rectangle "SGDE" {
  usecase "Cancelar evento confirmado\n(SGDE-61, SGDE-68)" as UC1
  usecase "Calcular monto retenido" as UC2
  usecase "Liberar la fecha del salón" as UC3
  usecase "Registrar movimiento" as UC4
}

AD --> UC1
UC1 ..> UC2 : <<include>>
UC1 ..> UC3 : <<include>>
UC1 ..> UC4 : <<include>>

note right of UC1
  Pide penalización (%) y motivo.
  Solo un evento confirmado (409 si no).
end note
@enduml
