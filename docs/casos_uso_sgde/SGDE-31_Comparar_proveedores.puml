@startuml SGDE-31_Comparar_proveedores
!pragma layout smetana
left to right direction
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #F2F2F2
  BorderColor black
  FontSize 12
}
skinparam rectangle {
  BorderColor black
  FontSize 13
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #B8A86B
  FontSize 11
}
skinparam ArrowColor black
skinparam actorStyle awesome
title SGDE-31 · Comparar proveedores (RF-12)

actor "Administrador" as AD

rectangle "SGDE" {
  usecase "Registrar proveedor" as UC1
  usecase "Registrar stock de un proveedor" as UC2
  usecase "Comparar precios por elemento" as UC3
  usecase "Marcar el mejor precio" as UC4
}

AD --> UC1
AD --> UC2
AD --> UC3
UC3 ..> UC4 : <<include>>

note right of UC3
  Agrupa el mismo elemento sin distinguir
  mayúsculas, tildes ni espacios de más.
end note
@enduml
