@startuml
left to right direction
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #F2F2F2
  BorderColor black
  FontSize 12
}
skinparam rectangle {
  BorderColor black
  FontSize 13
  FontStyle bold
}
skinparam ArrowColor black

actor "Administrador" as AD

rectangle "Sistema SGDE" {
  usecase "Registrar empresas" as UC1
  usecase "Registrar salón" as UC2
  usecase "Configurar\nmontajes" as UC3
  usecase "Registrar conceptos" as UC4
  usecase "Editar precios" as UC5
  usecase "Consultar histórico" as UC6
  usecase "Registrar usuario" as UC7
  usecase "Registrar hotel" as UC8
  usecase "Comparar\nproveedores" as UC9
}

AD --> UC1
AD --> UC2
AD --> UC3
AD --> UC4
AD --> UC5
AD --> UC6
AD --> UC7
AD --> UC8
AD --> UC9

UC3 ..> UC2 : <<extend>>
UC5 ..> UC4 : <<extend>>
UC7 ..> UC8 : <<extend>>
@enduml
