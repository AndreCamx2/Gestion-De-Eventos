@startuml SGDE-16_Registrar_conceptos
!pragma layout smetana
left to right direction
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #F2F2F2
  BorderColor black
  FontSize 12
}
skinparam rectangle {
  BorderColor black
  FontSize 13
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #B8A86B
  FontSize 11
}
skinparam ArrowColor black
skinparam actorStyle awesome
title SGDE-16 · Registrar conceptos (RF-05)

actor "Administrador" as AD

rectangle "SGDE" {
  usecase "Registrar concepto" as UC1
  usecase "Activar o desactivar concepto" as UC2
  usecase "Consultar catálogo del sitio" as UC3
}

AD --> UC1
AD --> UC2
AD --> UC3

note right of UC1
  Nombre, precio e impuesto en % (por ejemplo,
  19 % IVA u 8 % impoconsumo).
  Cada sitio tiene su propio catálogo.
end note
@enduml
