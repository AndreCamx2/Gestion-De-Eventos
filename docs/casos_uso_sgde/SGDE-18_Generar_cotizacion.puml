@startuml SGDE-18_Generar_cotizacion
!pragma layout smetana
left to right direction
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #F2F2F2
  BorderColor black
  FontSize 12
}
skinparam rectangle {
  BorderColor black
  FontSize 13
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #B8A86B
  FontSize 11
}
skinparam ArrowColor black
skinparam actorStyle awesome
title SGDE-18 · Generar cotización (RF-06)

actor "Administrador" as AD

rectangle "SGDE" {
  usecase "Generar cotización" as UC1
  usecase "Agregar conceptos del catálogo" as UC2
  usecase "Validar aforo del montaje" as UC3
  usecase "Calcular subtotal, impuestos\ny total" as UC4
  usecase "Imprimir cotización / PDF\n(SGDE-70)" as UC5
}

AD --> UC1
AD --> UC5
UC1 ..> UC2 : <<include>>
UC1 ..> UC3 : <<include>>
UC1 ..> UC4 : <<include>>

note right of UC1
  Cliente activo, salón activo, montaje
  habilitado, fecha futura. Nace "cotizada"
  con vigencia de 15 días si no se indica.
end note
@enduml
