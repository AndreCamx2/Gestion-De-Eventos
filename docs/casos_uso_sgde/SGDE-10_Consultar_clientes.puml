@startuml SGDE-10_Consultar_clientes
!pragma layout smetana
left to right direction
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #F2F2F2
  BorderColor black
  FontSize 12
}
skinparam rectangle {
  BorderColor black
  FontSize 13
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #B8A86B
  FontSize 11
}
skinparam ArrowColor black
skinparam actorStyle awesome
title SGDE-10 · Consultar clientes (RF-01)

actor "Administrador" as AD

rectangle "SGDE" {
  usecase "Consultar clientes" as UC1
  usecase "Buscar por nombre, identificación,\ncorreo o razón social" as UC2
  usecase "Ver cotizaciones del cliente" as UC3
  usecase "Editar cliente" as UC4
  usecase "Dar de baja cliente" as UC5
}

AD --> UC1
AD --> UC4
AD --> UC5
UC2 .> UC1 : <<extend>>
UC3 .> UC1 : <<extend>>

note right of UC3
  Solo muestra las cotizaciones de los
  sitios del administrador (SGDE-90).
end note
@enduml
