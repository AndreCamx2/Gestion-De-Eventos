@startuml SGDE-28_Registrar_usuario
!pragma layout smetana
left to right direction
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #F2F2F2
  BorderColor black
  FontSize 12
}
skinparam rectangle {
  BorderColor black
  FontSize 13
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #B8A86B
  FontSize 11
}
skinparam ArrowColor black
skinparam actorStyle awesome
title SGDE-28 · Registrar usuario

actor "Administrador" as AD

rectangle "SGDE" {
  usecase "Registrar usuario interno" as UC1
  usecase "Asignar rol y sitios" as UC2
  usecase "Editar usuario (SGDE-37)" as UC3
  usecase "Dar de baja usuario" as UC4
}

AD --> UC1
AD --> UC3
AD --> UC4
UC1 ..> UC2 : <<include>>

note right of UC2
  Solo puede asignar sus propios sitios.
  Nunca ve ni edita a un superusuario.
end note
note right of UC4
  Baja lógica: queda inactivo
  (y su cliente vinculado también).
end note
@enduml
