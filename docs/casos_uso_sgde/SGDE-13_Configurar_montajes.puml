@startuml SGDE-13_Configurar_montajes
!pragma layout smetana
left to right direction
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #F2F2F2
  BorderColor black
  FontSize 12
}
skinparam rectangle {
  BorderColor black
  FontSize 13
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #B8A86B
  FontSize 11
}
skinparam ArrowColor black
skinparam actorStyle awesome
title SGDE-13 · Configurar montajes (RF-03)

actor "Administrador" as AD

rectangle "SGDE" {
  usecase "Registrar tipo de montaje\n(catálogo)" as UC1
  usecase "Habilitar montaje en un salón\ncon su aforo" as UC2
  usecase "Editar aforo" as UC3
  usecase "Quitar montaje del salón" as UC4
  usecase "Verificar cotizaciones activas" as UC5
}

AD --> UC1
AD --> UC2
AD --> UC3
AD --> UC4
UC3 ..> UC5 : <<include>>
UC4 ..> UC5 : <<include>>

note bottom of UC5
  No se puede bajar el aforo por debajo de una
  cotización activa (400) ni quitar el montaje
  si tiene cotizaciones activas (409).
end note
@enduml
