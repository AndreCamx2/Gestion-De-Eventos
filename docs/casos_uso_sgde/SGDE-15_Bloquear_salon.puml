@startuml SGDE-15_Bloquear_salon
!pragma layout smetana
left to right direction
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #F2F2F2
  BorderColor black
  FontSize 12
}
skinparam rectangle {
  BorderColor black
  FontSize 13
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #B8A86B
  FontSize 11
}
skinparam ArrowColor black
skinparam actorStyle awesome
title SGDE-15 · Bloquear salón (RF-07)

actor "Administrador" as AD
actor "Sistema\n(tiempo)" as SIS

rectangle "SGDE" {
  usecase "Bloquear salón hasta\nuna fecha y hora" as UC1
  usecase "Liberar bloqueo a mano\n(SGDE-40)" as UC2
  usecase "Liberar bloqueos vencidos\n(SGDE-60)" as UC3
  usecase "Verificar que la fecha\nesté libre" as UC4
  usecase "Registrar movimiento" as UC5
}

AD --> UC1
AD --> UC2
SIS --> UC3
UC1 ..> UC4 : <<include>>
UC1 ..> UC5 : <<include>>
UC2 ..> UC5 : <<include>>
UC3 ..> UC5 : <<include>>

note right of UC1
  El bloqueo es un estado de la cotización
  (cotizado → bloqueado), no del salón.
  Solo una cotización no vencida.
end note
note right of UC4
  409 si otra cotización está confirmada
  o bloqueada ese día en ese salón.
end note
@enduml
