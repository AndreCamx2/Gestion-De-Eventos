@startuml SGDE-19_Definir_vigencia
!pragma layout smetana
left to right direction
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #F2F2F2
  BorderColor black
  FontSize 12
}
skinparam rectangle {
  BorderColor black
  FontSize 13
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #B8A86B
  FontSize 11
}
skinparam ArrowColor black
skinparam actorStyle awesome
title SGDE-19 · Definir vigencia (RF-07)

actor "Administrador" as AD

rectangle "SGDE" {
  usecase "Extender vigencia de la oferta" as UC1
  usecase "Registrar movimiento" as UC2
}

AD --> UC1
UC1 ..> UC2 : <<include>>

note right of UC1
  Solo cotizaciones en estado cotizado,
  aunque ya estén vencidas. La nueva fecha
  va de hoy al día del evento.
end note
@enduml
