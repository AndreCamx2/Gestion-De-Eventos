@startuml SGDE-17_Editar_precios
!pragma layout smetana
left to right direction
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #F2F2F2
  BorderColor black
  FontSize 12
}
skinparam rectangle {
  BorderColor black
  FontSize 13
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #B8A86B
  FontSize 11
}
skinparam ArrowColor black
skinparam actorStyle awesome
title SGDE-17 · Editar precios (RF-05)

actor "Administrador" as AD

rectangle "SGDE" {
  usecase "Editar precio del concepto" as UC1
  usecase "Guardar historial de precio" as UC2
  usecase "Consultar historial de precios" as UC3
}

AD --> UC1
AD --> UC3
UC1 ..> UC2 : <<include>>

note right of UC1
  Las cotizaciones ya hechas conservan
  el precio con que se cotizaron.
end note
@enduml
