@startuml SGDE-09_Registrar_cliente
!pragma layout smetana
left to right direction
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #F2F2F2
  BorderColor black
  FontSize 12
}
skinparam rectangle {
  BorderColor black
  FontSize 13
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #B8A86B
  FontSize 11
}
skinparam ArrowColor black
skinparam actorStyle awesome
title SGDE-09 · Registrar cliente (RF-01)

actor "Administrador" as AD
actor "Visitante\n(sin sesión)" as VI

rectangle "SGDE" {
  usecase "Registrar cliente" as UC1
  usecase "Registrar empresa" as UC2
  usecase "Registrarse como cliente\n(registro público)" as UC3
  usecase "Crear usuario con rol cliente" as UC4
}

AD --> UC1
VI --> UC3
UC2 .> UC1 : <<extend>>\n[cliente jurídico\ncon empresa nueva]
UC3 ..> UC4 : <<include>>
UC3 ..> UC2 : <<include>>

note right of UC1
  Natural: identificación única.
  Jurídico: la empresa es obligatoria y
  el NIT es el de la empresa.
end note
@enduml
