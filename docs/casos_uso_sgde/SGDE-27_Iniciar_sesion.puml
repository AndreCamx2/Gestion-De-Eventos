@startuml SGDE-27_Iniciar_sesion
!pragma layout smetana
left to right direction
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #F2F2F2
  BorderColor black
  FontSize 12
}
skinparam rectangle {
  BorderColor black
  FontSize 13
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #B8A86B
  FontSize 11
}
skinparam ArrowColor black
skinparam actorStyle awesome
title SGDE-27 · Iniciar sesión (JWT)

actor "Usuario" as US
actor "Administrador" as AD
actor "Proveedor" as PR
actor "Cliente" as CL
actor "Visitante\n(sin sesión)" as VI

AD -up-|> US
PR -up-|> US
CL -up-|> US

rectangle "SGDE" {
  usecase "Iniciar sesión\n(usuario o correo)" as UC1
  usecase "Renovar la sesión\n(automático)" as UC2
  usecase "Cerrar sesión\n(SGDE-92)" as UC3
  usecase "Recuperar contraseña\n(SGDE-96)" as UC4
}

US --> UC1
US --> UC3
VI --> UC4
UC2 .> UC1 : <<extend>>\n[venció el access]

note right of UC3
  El refresh pasa a la lista negra:
  ya no sirve para renovar.
end note
@enduml
