@startuml SGDE-30_Actualizar_stock
!pragma layout smetana
left to right direction
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #F2F2F2
  BorderColor black
  FontSize 12
}
skinparam rectangle {
  BorderColor black
  FontSize 13
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #B8A86B
  FontSize 11
}
skinparam ArrowColor black
skinparam actorStyle awesome
title SGDE-30 · Actualizar stock de elementos (Mi stock)

actor "Proveedor" as PR
actor "Administrador" as AD

rectangle "SGDE" {
  usecase "Consultar mi stock" as UC1
  usecase "Agregar elemento" as UC2
  usecase "Actualizar cantidad y valor" as UC3
  usecase "Vincular usuario al proveedor" as UC4
}

PR --> UC1
PR --> UC2
PR --> UC3
AD --> UC4

note right of UC1
  El proveedor solo ve y edita el stock
  de su propio Proveedor. Sin vincular: 403
  con codigo "proveedor_sin_vincular".
end note
@enduml
