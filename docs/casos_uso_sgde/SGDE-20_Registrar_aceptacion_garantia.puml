@startuml SGDE-20_Registrar_aceptacion_garantia
!pragma layout smetana
left to right direction
skinparam backgroundColor white
skinparam usecase {
  BackgroundColor #F2F2F2
  BorderColor black
  FontSize 12
}
skinparam rectangle {
  BorderColor black
  FontSize 13
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #B8A86B
  FontSize 11
}
skinparam ArrowColor black
skinparam actorStyle awesome
title SGDE-20 · Registrar aceptación y garantía (RF-08)

actor "Administrador" as AD

rectangle "SGDE" {
  usecase "Registrar aceptación\ny garantía" as UC1
  usecase "Confirmar evento" as UC2
  usecase "Verificar que la fecha\nesté libre" as UC3
}

AD --> UC1
UC1 ..> UC2 : <<include>>
UC2 ..> UC3 : <<include>>

note right of UC1
  Tipo de garantía (transferencia, tarjeta,
  consignación o efectivo) y monto.
  Desde cotizada no vencida o bloqueada.
end note
@enduml
