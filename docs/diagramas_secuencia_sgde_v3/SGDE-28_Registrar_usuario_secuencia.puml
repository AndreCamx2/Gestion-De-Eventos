@startuml SGDE-28_Registrar_usuario_secuencia
title SGDE-28 · Registrar usuario
skinparam backgroundColor white
skinparam sequence {
  ArrowColor black
  LifeLineBorderColor black
  ParticipantBorderColor black
  ParticipantBackgroundColor #F2F2F2
  ActorBorderColor black
  ActorBackgroundColor #F2F2F2
}
skinparam database {
  BackgroundColor #F2F2F2
  BorderColor black
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #B8A86B
}
autonumber

actor "Administrador" as AD
participant "Interfaz\n(React)" as UI
participant "API\n(Django REST)" as SI
database "Base de datos\n(PostgreSQL)" as BD

AD -> UI : Abrir Usuarios y "Nuevo usuario"
UI -> SI : GET /api/roles/ y GET /api/sitios/
SI --> UI : Roles y sitios del administrador
AD -> UI : Usuario, correo, contraseña inicial, rol y sitios
UI -> SI : POST /api/usuarios/
SI -> SI : Validar campos, contraseña segura\ny que los sitios sean suyos
alt Falta un campo o la contraseña es débil
  SI --> UI : 400 con el error de cada campo
  UI --> AD : Mostrar el error bajo cada campo
else Usuario ya existe
  SI --> UI : 400 en "username"
  UI --> AD : Avisar que el usuario ya existe
else Sitio que no es suyo
  SI --> UI : 400 en "sitios"
  UI --> AD : Mostrar el error bajo "sitios"
else Datos válidos
  SI -> SI : Cifrar contraseña
  SI -> BD : Guardar usuario con rol y sitios
  SI --> UI : 201 con el usuario
  UI --> AD : Mostrar el usuario en la lista
end
@enduml
