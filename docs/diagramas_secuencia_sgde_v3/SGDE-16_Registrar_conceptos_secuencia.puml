@startuml SGDE-16_Registrar_conceptos_secuencia
title SGDE-16 · Registrar conceptos (RF-05)
skinparam backgroundColor white
skinparam sequence {
  ArrowColor black
  LifeLineBorderColor black
  ParticipantBorderColor black
  ParticipantBackgroundColor #F2F2F2
  ActorBorderColor black
  ActorBackgroundColor #F2F2F2
}
skinparam database {
  BackgroundColor #F2F2F2
  BorderColor black
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #B8A86B
}
autonumber

actor "Administrador" as AD
participant "Interfaz\n(React)" as UI
participant "API\n(Django REST)" as SI
database "Base de datos\n(PostgreSQL)" as BD

AD -> UI : Abrir Conceptos y "Nuevo concepto"
AD -> UI : Sitio, nombre, precio e impuesto (%)
UI -> SI : POST /api/conceptos/
SI -> SI : Validar datos y que el sitio sea del administrador
alt Datos inválidos o sitio ajeno
  SI --> UI : 400 con el error de cada campo
  UI --> AD : Mostrar el error bajo cada campo
else Datos válidos (CP-09)
  SI -> BD : Guardar concepto activo
  BD --> SI : Concepto guardado
  SI --> UI : 201 con el concepto
  UI --> AD : Mostrar el concepto en el catálogo
end
@enduml
