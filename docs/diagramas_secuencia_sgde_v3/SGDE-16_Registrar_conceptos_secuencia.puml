@startuml SGDE-16_Registrar_conceptos_secuencia
title SGDE-16 - Registrar conceptos (RF-05)
skinparam backgroundColor white
skinparam sequence {
  ArrowColor black
  LifeLineBorderColor black
  ParticipantBorderColor black
  ParticipantBackgroundColor #F2F2F2
  ActorBorderColor black
  ActorBackgroundColor #F2F2F2
}
skinparam database {
  BackgroundColor #F2F2F2
  BorderColor black
}
autonumber

actor "Administrador" as AD
participant "Interfaz" as UI
participant "Sistema" as SI
database "Base de datos" as BD

AD -> UI : Seleccionar "Registrar concepto"
UI --> AD : Mostrar formulario de producto o servicio
AD -> UI : Ingresar nombre, precio base e impuestos aplicables
UI -> SI : Enviar datos del concepto
SI -> SI : Validar datos ingresados

alt Datos inválidos o incompletos
  SI --> UI : Informar error de validación
  UI --> AD : Mostrar mensaje de error de validación
else Datos válidos (CP-09)
  SI -> BD : Guardar concepto y habilitarlo en el catálogo
  BD --> SI : Confirmar registro
  SI --> UI : Informar registro exitoso
  UI --> AD : Mostrar mensaje "Concepto habilitado en el catálogo"
end
@enduml
