@startuml SGDE-14_Consultar_disponibilidad_secuencia
title SGDE-14 · Consultar disponibilidad (RF-04)
skinparam backgroundColor white
skinparam sequence {
  ArrowColor black
  LifeLineBorderColor black
  ParticipantBorderColor black
  ParticipantBackgroundColor #F2F2F2
  ActorBorderColor black
  ActorBackgroundColor #F2F2F2
}
skinparam database {
  BackgroundColor #F2F2F2
  BorderColor black
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #B8A86B
}
autonumber

actor "Administrador" as AD
participant "Interfaz\n(React)" as UI
participant "API\n(Django REST)" as SI
database "Base de datos\n(PostgreSQL)" as BD

AD -> UI : Abrir Calendario (un salón, un mes)\no Rack (todos los salones, varios días)
UI -> SI : GET /api/calendario/?salon=&desde=&hasta=
SI -> SI : Validar fechas y salón (400 si no son válidos)
SI -> BD : Cotizaciones no canceladas del rango,\nsolo de los sitios del administrador
BD --> SI : Cotizaciones con estado y fecha
SI --> UI : 200 con la lista
alt Día sin cotizaciones (CP-07)
  UI --> AD : Mostrar el día libre
else Día con cotizaciones (CP-08)
  UI --> AD : Mostrar el día con el color del estado más fuerte\n(confirmado, bloqueado, cotizado o vencida)
end
@enduml
