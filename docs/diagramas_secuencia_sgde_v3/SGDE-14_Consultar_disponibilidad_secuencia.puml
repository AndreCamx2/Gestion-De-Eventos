@startuml SGDE-14_Consultar_disponibilidad_secuencia
title SGDE-14 - Consultar disponibilidad (RF-04)
skinparam backgroundColor white
skinparam sequence {
  ArrowColor black
  LifeLineBorderColor black
  ParticipantBorderColor black
  ParticipantBackgroundColor #F2F2F2
  ActorBorderColor black
  ActorBackgroundColor #F2F2F2
}
skinparam database {
  BackgroundColor #F2F2F2
  BorderColor black
}
autonumber

actor "Ejecutivo comercial" as EC
participant "Interfaz" as UI
participant "Sistema" as SI
database "Base de datos" as BD

EC -> UI : Seleccionar "Consultar disponibilidad"
UI --> EC : Mostrar calendario
EC -> UI : Seleccionar salón, fecha y horario
UI -> SI : Enviar salón, fecha y horario
SI -> BD : Buscar reservas y bloqueos del rango
BD --> SI : Resultado de consulta

alt Sin reservas ni bloqueos (CP-07)
  SI --> UI : Informar estado "Disponible"
  UI --> EC : Mostrar salón "Disponible"
else Con reserva o bloqueo (CP-08)
  SI --> UI : Informar estado "Ocupado / Bloqueado"
  UI --> EC : Notificar que el espacio no está disponible
end
@enduml
