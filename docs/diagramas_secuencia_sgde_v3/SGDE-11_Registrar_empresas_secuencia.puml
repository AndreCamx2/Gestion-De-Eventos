@startuml SGDE-11_Registrar_empresas_secuencia
title SGDE-11 · Registrar empresas
skinparam backgroundColor white
skinparam sequence {
  ArrowColor black
  LifeLineBorderColor black
  ParticipantBorderColor black
  ParticipantBackgroundColor #F2F2F2
  ActorBorderColor black
  ActorBackgroundColor #F2F2F2
}
skinparam database {
  BackgroundColor #F2F2F2
  BorderColor black
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #B8A86B
}
autonumber

actor "Administrador" as AD
participant "Interfaz\n(React)" as UI
participant "API\n(Django REST)" as SI
database "Base de datos\n(PostgreSQL)" as BD

AD -> UI : Abrir "Nueva empresa"
AD -> UI : Razón social, NIT, contacto, correo y ciudad
UI -> SI : POST /api/empresas/
SI -> SI : Validar campos
alt Falta un campo obligatorio
  SI --> UI : 400 con el error de cada campo
  UI --> AD : Mostrar el error bajo cada campo
else NIT ya registrado
  SI --> UI : 400 en "identificacion"
  UI --> AD : Avisar que el NIT ya está registrado
else Datos válidos
  SI -> BD : Guardar empresa
  BD --> SI : Empresa guardada
  SI --> UI : 201 con la empresa
  UI --> AD : Mostrar la empresa (ya se puede elegir para un cliente jurídico)
end
@enduml
