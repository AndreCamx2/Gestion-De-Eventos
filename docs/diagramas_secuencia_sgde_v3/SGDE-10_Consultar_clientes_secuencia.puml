@startuml SGDE-10_Consultar_clientes_secuencia
title SGDE-10 · Consultar clientes (RF-01)
skinparam backgroundColor white
skinparam sequence {
  ArrowColor black
  LifeLineBorderColor black
  ParticipantBorderColor black
  ParticipantBackgroundColor #F2F2F2
  ActorBorderColor black
  ActorBackgroundColor #F2F2F2
}
skinparam database {
  BackgroundColor #F2F2F2
  BorderColor black
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #B8A86B
}
autonumber

actor "Administrador" as AD
participant "Interfaz\n(React)" as UI
participant "API\n(Django REST)" as SI
database "Base de datos\n(PostgreSQL)" as BD

AD -> UI : Escribir en el buscador (nombre, identificación,\ncorreo o razón social)
UI -> SI : GET /api/clientes/?search=texto
SI -> BD : Buscar clientes que coincidan
BD --> SI : Clientes con sus cotizaciones
SI -> SI : Dejar solo las cotizaciones\nde los sitios del administrador
alt Hay coincidencias
  SI --> UI : 200 con la lista
  UI --> AD : Mostrar los clientes
else Sin coincidencias
  SI --> UI : 200 con lista vacía
  UI --> AD : Mostrar que no hay resultados
end
@enduml
