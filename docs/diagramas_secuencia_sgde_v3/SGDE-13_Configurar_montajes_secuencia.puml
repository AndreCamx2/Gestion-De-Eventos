@startuml SGDE-13_Configurar_montajes_secuencia
title SGDE-13 · Configurar montajes (RF-03)
skinparam backgroundColor white
skinparam sequence {
  ArrowColor black
  LifeLineBorderColor black
  ParticipantBorderColor black
  ParticipantBackgroundColor #F2F2F2
  ActorBorderColor black
  ActorBackgroundColor #F2F2F2
}
skinparam database {
  BackgroundColor #F2F2F2
  BorderColor black
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #B8A86B
}
autonumber

actor "Administrador" as AD
participant "Interfaz\n(React)" as UI
participant "API\n(Django REST)" as SI
database "Base de datos\n(PostgreSQL)" as BD

AD -> UI : Abrir un salón y "Habilitar montaje"
UI -> SI : GET /api/montajes/
SI -> BD : Consultar catálogo de montajes
BD --> SI : Auditorio, escuela, imperial, cóctel...
SI --> UI : 200 con los montajes
AD -> UI : Elegir el montaje y escribir su aforo
UI -> SI : POST /api/salon-montajes/
SI -> SI : Validar aforo y que el salón sea del administrador
alt Aforo inválido o montaje ya habilitado en el salón
  SI --> UI : 400 con el error
  UI --> AD : Mostrar el error
else Configuración válida (CP-06)
  SI -> BD : Guardar salón–montaje con su aforo
  BD --> SI : Guardado
  SI --> UI : 201
  UI --> AD : Mostrar el montaje con su aforo
end
@enduml
