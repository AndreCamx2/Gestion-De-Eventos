@startuml SGDE-13_Configurar_montajes_secuencia
title SGDE-13 - Configurar montajes (RF-03)
skinparam backgroundColor white
skinparam sequence {
  ArrowColor black
  LifeLineBorderColor black
  ParticipantBorderColor black
  ParticipantBackgroundColor #F2F2F2
  ActorBorderColor black
  ActorBackgroundColor #F2F2F2
}
skinparam database {
  BackgroundColor #F2F2F2
  BorderColor black
}
autonumber

actor "Administrador" as AD
participant "Interfaz" as UI
participant "Sistema" as SI
database "Base de datos" as BD

AD -> UI : Seleccionar "Configurar montajes"
UI -> SI : Solicitar montajes configurados
SI -> BD : Consultar montajes
BD --> SI : Montajes y capacidades
SI --> UI : Enviar montajes
UI --> AD : Mostrar tipos de montaje y capacidades
AD -> UI : Ingresar tipo de montaje (Auditorio, Banquete) y su capacidad
UI -> SI : Enviar configuración del montaje
SI -> SI : Validar capacidad

alt Capacidad inválida
  SI --> UI : Informar error de formato
  UI --> AD : Mostrar mensaje de error de formato
else Configuración válida (CP-06)
  SI -> BD : Guardar configuración del montaje
  BD --> SI : Confirmar registro
  SI --> UI : Informar configuración actualizada
  UI --> AD : Mostrar mensaje "Montaje configurado correctamente"
end
@enduml
