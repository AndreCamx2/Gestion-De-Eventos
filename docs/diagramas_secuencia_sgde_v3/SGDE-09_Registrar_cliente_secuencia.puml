@startuml SGDE-09_Registrar_cliente_secuencia
title SGDE-09 · Registrar cliente (RF-01)
skinparam backgroundColor white
skinparam sequence {
  ArrowColor black
  LifeLineBorderColor black
  ParticipantBorderColor black
  ParticipantBackgroundColor #F2F2F2
  ActorBorderColor black
  ActorBackgroundColor #F2F2F2
}
skinparam database {
  BackgroundColor #F2F2F2
  BorderColor black
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #B8A86B
}
autonumber

actor "Administrador" as AD
participant "Interfaz\n(React)" as UI
participant "API\n(Django REST)" as SI
database "Base de datos\n(PostgreSQL)" as BD

AD -> UI : Abrir Clientes y "Nuevo cliente"
AD -> UI : Tipo (natural o jurídica), nombre, identificación\no empresa, correo, teléfono, forma de pago
UI -> SI : POST /api/clientes/
SI -> SI : Validar campos
alt Falta un campo obligatorio o la empresa de un jurídico (CP-02)
  SI --> UI : 400 con el error de cada campo
  UI --> AD : Mostrar el error bajo cada campo
else Identificación ya registrada (CP-03)
  SI --> UI : 400 en "identificacion"
  UI --> AD : Avisar que la identificación ya está registrada
else Datos válidos (CP-01)
  SI -> BD : Guardar cliente
  BD --> SI : Cliente guardado
  SI --> UI : 201 con el cliente
  UI --> AD : Mostrar el cliente en la lista
end
@enduml
