@startuml EXTRA_RF-12_Registrar_proveedor_secuencia
title RF-12 - Registrar proveedor y sus montajes
skinparam backgroundColor white
skinparam sequence {
  ArrowColor black
  LifeLineBorderColor black
  ParticipantBorderColor black
  ParticipantBackgroundColor #F2F2F2
  ActorBorderColor black
  ActorBackgroundColor #F2F2F2
}
skinparam database {
  BackgroundColor #F2F2F2
  BorderColor black
}
autonumber

actor "Administrador" as AD
participant "Interfaz" as UI
participant "Sistema" as SI
database "Base de datos" as BD

AD -> UI : Seleccionar "Registrar proveedor"
UI -> SI : Solicitar tipos de montaje
SI -> BD : Consultar montajes
BD --> SI : Tipos de montaje
SI --> UI : Enviar montajes
UI --> AD : Mostrar formulario y montajes disponibles
AD -> UI : Ingresar datos del proveedor y seleccionar los montajes que ofrece
UI -> SI : Enviar datos del proveedor y montajes
SI -> SI : Validar datos ingresados

alt Campos obligatorios vacíos
  SI --> UI : Informar campos obligatorios faltantes
  UI --> AD : Mostrar alerta "Todos los campos son obligatorios"
else Datos válidos (CP-19)
  SI -> BD : Guardar proveedor y vincularlo con sus montajes
  BD --> SI : Confirmar registro
  SI --> UI : Informar registro exitoso
  UI --> AD : Mostrar mensaje "Proveedor registrado y vinculado a sus montajes"
end
@enduml
