@startuml SGDE-30_Actualizar_stock_secuencia
title SGDE-30 · Actualizar stock (Mi stock)
skinparam backgroundColor white
skinparam sequence {
  ArrowColor black
  LifeLineBorderColor black
  ParticipantBorderColor black
  ParticipantBackgroundColor #F2F2F2
  ActorBorderColor black
  ActorBackgroundColor #F2F2F2
}
skinparam database {
  BackgroundColor #F2F2F2
  BorderColor black
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #B8A86B
}
autonumber

actor "Proveedor" as PR
participant "Interfaz\n(React)" as UI
participant "API\n(Django REST)" as SI
database "Base de datos\n(PostgreSQL)" as BD

PR -> UI : Abrir "Mi stock"
UI -> SI : GET /api/mi-stock/
alt Su usuario no está vinculado a un proveedor
  SI --> UI : 403 {codigo: "proveedor_sin_vincular"}
  UI --> PR : Mostrar el aviso para pedir la vinculación
else Vinculado
  SI -> BD : Stock de SU proveedor
  BD --> SI : Elementos
  SI --> UI : 200 con los elementos
  UI --> PR : Mostrar su stock
  PR -> UI : Cambiar cantidad y valor de un elemento
  UI -> SI : PATCH /api/mi-stock/{id}/ {cantidad, valor}
  alt Cantidad o valor negativos
    SI --> UI : 400 con el error de cada campo
    UI --> PR : Mostrar el error bajo cada campo
  else Elemento de otro proveedor
    SI --> UI : 404
  else Datos válidos
    SI -> BD : Actualizar cantidad y valor
    SI --> UI : 200 con el elemento
    UI --> PR : Mostrar el elemento actualizado
  end
end
@enduml
