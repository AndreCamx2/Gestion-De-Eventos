@startuml SGDE-17_Editar_precios_secuencia
title SGDE-17 - Editar precios (RF-05)
skinparam backgroundColor white
skinparam sequence {
  ArrowColor black
  LifeLineBorderColor black
  ParticipantBorderColor black
  ParticipantBackgroundColor #F2F2F2
  ActorBorderColor black
  ActorBackgroundColor #F2F2F2
}
skinparam database {
  BackgroundColor #F2F2F2
  BorderColor black
}
autonumber

actor "Administrador" as AD
participant "Interfaz" as UI
participant "Sistema" as SI
database "Base de datos" as BD

AD -> UI : Seleccionar "Editar precios"
UI -> SI : Solicitar catálogo de conceptos
SI -> BD : Consultar conceptos
BD --> SI : Conceptos con su precio actual
SI --> UI : Enviar catálogo
UI --> AD : Mostrar conceptos con su precio actual
AD -> UI : Seleccionar concepto e ingresar nuevo precio
UI -> SI : Enviar nuevo precio
SI -> SI : Validar precio

alt Precio inválido (vacío, negativo o no numérico)
  SI --> UI : Informar error de formato
  UI --> AD : Mostrar mensaje de error de formato
else Precio válido
  SI -> BD : Actualizar precio
  BD --> SI : Confirmar actualización
  SI --> UI : Informar actualización exitosa
  UI --> AD : Mostrar mensaje "Precio actualizado correctamente"
end
@enduml
