@startuml CU22_ImprimirCotizacion
title CU-22 · Imprimir cotización o guardarla en PDF (SGDE-70)
skinparam backgroundColor white
skinparam ActivityBackgroundColor #F2F2F2
skinparam ActivityBorderColor black
skinparam ActivityDiamondBackgroundColor white
skinparam ActivityDiamondBorderColor black
skinparam ArrowColor black
skinparam SwimlaneBorderColor #9AA3AE
skinparam SwimlaneTitleFontStyle bold
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #B8A86B
}

|Administrador|
start
:Abre el detalle de una cotización;
:Elige "Imprimir o PDF";
|Sistema|
:Abre la vista para imprimir en la misma pestaña;
:Muestra cliente, salón, montaje, fecha,
conceptos con su impuesto (IVA, impoconsumo),
subtotal, impuestos por tasa y total;
|Administrador|
:Usa el diálogo de impresión del navegador
para imprimir o guardar en PDF;
stop
@enduml
