@startuml CU05_GenerarCotizacion
title CU-05 · Generar cotización (SGDE-18)
skinparam backgroundColor white
skinparam ActivityBackgroundColor #F2F2F2
skinparam ActivityBorderColor black
skinparam ActivityDiamondBackgroundColor white
skinparam ActivityDiamondBorderColor black
skinparam ArrowColor black
skinparam SwimlaneBorderColor #9AA3AE
skinparam SwimlaneTitleFontStyle bold
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #B8A86B
}

|Administrador|
start
:Abre "Nueva cotización";
:Elige cliente, salón, montaje,
fecha del evento y número de personas;
|Sistema|
:Avisa la disponibilidad del salón ese día
(confirmado, bloqueado, otras abiertas o libre);
|Administrador|
:Agrega conceptos con su cantidad
(los "por persona" toman el número de personas);
:La pantalla muestra subtotal, impuestos
(IVA, impoconsumo) y total;
:Puede abrir la vista previa para el cliente;
:Guarda;
|Sistema|
:Bloquea el salón y su montaje
mientras revisa (SGDE-100);
if (¿Todo válido?) then (no)
  :Responde 400: cliente o salón dado de baja,
  montaje no habilitado, aforo superado,
  fecha pasada o concepto inactivo;
  stop
else (sí)
  :Guarda la cotización en estado cotizado
  con los precios del catálogo;
  :Vigencia: la indicada o 15 días
  (sin pasar del día del evento);
  :Registra el movimiento "creada";
endif
|Administrador|
:Ve "Quedó guardada" con el enlace al detalle;
stop
@enduml
