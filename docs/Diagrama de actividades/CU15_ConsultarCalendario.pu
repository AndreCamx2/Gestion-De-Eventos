@startuml CU15_ConsultarCalendario
title CU-15 · Consultar disponibilidad (SGDE-14, SGDE-45, SGDE-69)
skinparam backgroundColor white
skinparam ActivityBackgroundColor #F2F2F2
skinparam ActivityBorderColor black
skinparam ActivityDiamondBackgroundColor white
skinparam ActivityDiamondBorderColor black
skinparam ArrowColor black
skinparam SwimlaneBorderColor #9AA3AE
skinparam SwimlaneTitleFontStyle bold
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #B8A86B
}

|Administrador|
start
if (¿Qué vista?) then (calendario)
  :Elige el salón y el mes;
else (rack)
  :Ve todos los salones
  durante varios días;
endif
|Sistema|
:Busca las cotizaciones no canceladas
del rango, solo de sus sitios;
|Administrador|
:Ve cada día con el color de su estado
(cotizado, bloqueado, confirmado, vencida);
if (¿Abre un día de un salón?) then (sí)
  :Ve las cotizaciones de ese día;
  if (¿Quiere bloquear o liberar?) then (sí)
    :Bloquea o libera desde el panel del día;
  else (no)
  endif
else (no)
endif
stop
@enduml
