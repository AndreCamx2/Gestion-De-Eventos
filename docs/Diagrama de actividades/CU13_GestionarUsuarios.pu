@startuml CU13_GestionarUsuarios
title CU-13 · Gestionar usuarios internos (SGDE-28, SGDE-37)
skinparam backgroundColor white
skinparam ActivityBackgroundColor #F2F2F2
skinparam ActivityBorderColor black
skinparam ActivityDiamondBackgroundColor white
skinparam ActivityDiamondBorderColor black
skinparam ArrowColor black
skinparam SwimlaneBorderColor #9AA3AE
skinparam SwimlaneTitleFontStyle bold
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #B8A86B
}

|Administrador|
start
:Abre Usuarios y elige "Nuevo usuario";
:Escribe usuario, correo y contraseña inicial;
:Elige el rol y uno o varios de sus sitios;
|Sistema|
if (¿Sitios propios, usuario único y contraseña
segura?) then (no)
  :Responde 400 con el error de cada campo;
  stop
else (sí)
  :Guarda el usuario con la contraseña cifrada;
endif
|Administrador|
if (¿Dar de baja a un usuario?) then (sí)
  |Sistema|
  :Lo marca inactivo
  (y a su cliente vinculado);
else (no)
endif
stop
@enduml
