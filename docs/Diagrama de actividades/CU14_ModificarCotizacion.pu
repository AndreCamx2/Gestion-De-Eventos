@startuml CU14_ModificarCotizacion
title CU-14 · Modificar una cotización: editar o extender la vigencia (SGDE-19)
skinparam backgroundColor white
skinparam ActivityBackgroundColor #F2F2F2
skinparam ActivityBorderColor black
skinparam ActivityDiamondBackgroundColor white
skinparam ActivityDiamondBorderColor black
skinparam ArrowColor black
skinparam SwimlaneBorderColor #9AA3AE
skinparam SwimlaneTitleFontStyle bold
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #B8A86B
}

|Administrador|
start
:Abre una cotización;
if (¿Qué quiere cambiar?) then (solo la vigencia)
  :Elige una fecha nueva de validez de la oferta;
  |Sistema|
  if (¿Está en estado cotizado
  y el salón activo?) then (no)
    :Responde 409;
    stop
  elseif (¿La fecha va de hoy al día
  del evento?) then (no)
    :Responde 400;
    stop
  else (sí)
    :Guarda la nueva vigencia
    (aunque la oferta ya hubiera vencido);
    :Registra el movimiento "vigencia"
    con la fecha anterior y la nueva;
  endif
else (cliente, salón, fecha, personas o conceptos)
  |Administrador|
  :Elige "Editar" y cambia los datos;
  |Sistema|
  if (¿Está en estado cotizado?) then (no)
    :Responde 409
    (una bloqueada se libera primero);
    stop
  elseif (¿Datos válidos, igual que al crear?) then (no)
    :Responde 400 con el error de cada campo;
    stop
  else (sí)
    :Reemplaza los datos y los conceptos;
    :Los conceptos que ya estaban conservan su precio;
    :Registra el movimiento "editada"
    con lo que cambió;
  endif
  |Administrador|
  :Vuelve al detalle con
  "Los cambios quedaron guardados";
endif
stop
@enduml
