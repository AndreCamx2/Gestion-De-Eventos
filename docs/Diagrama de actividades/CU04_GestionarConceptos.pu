@startuml CU04_GestionarConceptos
title CU-04 · Gestionar conceptos y precios (SGDE-16, SGDE-17)
skinparam backgroundColor white
skinparam ActivityBackgroundColor #F2F2F2
skinparam ActivityBorderColor black
skinparam ActivityDiamondBackgroundColor white
skinparam ActivityDiamondBorderColor black
skinparam ArrowColor black
skinparam SwimlaneBorderColor #9AA3AE
skinparam SwimlaneTitleFontStyle bold
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #B8A86B
}

|Administrador|
start
if (¿Concepto nuevo o edición?) then (nuevo)
  :Escribe sitio, nombre, precio
  e impuesto (%);
  |Sistema|
  :Guarda el concepto activo en el
  catálogo de ese sitio;
else (edición)
  |Administrador|
  :Cambia precio, impuesto o lo desactiva;
  |Sistema|
  if (¿Cambió el precio?) then (sí)
    :Guarda el precio anterior, el nuevo,
    quién y cuándo en el historial;
  else (no)
  endif
  :Guarda los cambios;
endif
|Administrador|
:El concepto queda disponible
(si está activo) para nuevas cotizaciones;
note right
  Las cotizaciones ya hechas conservan
  el precio con que se cotizaron.
end note
stop
@enduml
