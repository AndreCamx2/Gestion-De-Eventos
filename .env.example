# =============================================================================
# SGDE - Variables para Docker Compose (archivo .env en la RAÍZ del repo)
# Copia este archivo a ".env" y ajusta los valores:
#     Copy-Item .env.example .env
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).
# =============================================================================

# --- Base de datos (contenedor "db") -----------------------------------------
# Nombre de la base de datos que se crea al levantar Postgres por primera vez.
DB_NAME=sgde_db
# Usuario de Postgres.
DB_USER=postgres
# Contraseña de Postgres. OBLIGATORIA: docker compose no arranca sin ella.
# Elige cualquiera para desarrollo local; no uses una contraseña real.
DB_PASSWORD=

# --- Backend (Django) ---------------------------------------------------------
# Clave secreta de Django. OBLIGATORIA: el backend no arranca sin ella.
# Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# --- Frontend (Vite) ----------------------------------------------------------
# URL del backend tal como la ve el NAVEGADOR (no el contenedor). Por eso es
# localhost:8000 y no http://backend:8000. Se "hornea" en el build: si la
# cambias, ejecuta "docker compose up --build".
VITE_API_URL=http://localhost:8000/api

# --- Datos de demostración (comando seed_demo) --------------------------------
# Contraseñas de los usuarios demo: admin, cliente_demo y proveedor_demo.
# Si las dejas vacías, el comando usa valores por defecto SOLO para desarrollo.
SEED_ADMIN_PASSWORD=
SEED_CLIENTE_PASSWORD=
SEED_PROVEEDOR_PASSWORD=
