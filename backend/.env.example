# =============================================================================
# SGDE - Variables del backend (archivo backend/.env)
# Se lee con venv + runserver y TAMBIÉN dentro de Docker: el contenedor monta
# backend/ en /app y settings.py llama a load_dotenv(), que encuentra /app/.env.
# Con "docker compose up", las variables que define docker-compose.yml
# (DB_*, SECRET_KEY, DEBUG, SEED_*) tienen prioridad sobre las de este archivo;
# las demás (por ejemplo JWT_*) salen de aquí. Tras cambiarlo, reinicia el
# backend: docker compose restart backend
# Copia este archivo:   Copy-Item .env.example .env
# El archivo .env NUNCA se sube a GitHub.
# =============================================================================

# Clave secreta de Django. OBLIGATORIA: sin ella el servidor no arranca.
# Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Modo debug. True solo en desarrollo; si falta, vale False (modo seguro).
# seed_demo exige DEBUG=True.
DEBUG=True

# Hosts permitidos, separados por coma. Si falta: '*' con DEBUG=True,
# o .onrender.com/localhost/127.0.0.1 con DEBUG=False.
# ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos local (se ignoran si defines DATABASE_URL) -----------------
DB_NAME=sgde_db
DB_USER=postgres
DB_PASSWORD=
# "db" es el nombre del servicio en Docker. Si corres Django fuera de Docker
# contra el Postgres del compose, usa localhost.
DB_HOST=localhost
DB_PORT=5432

# --- Duración de la sesión (tokens JWT, SGDE-86) ------------------------------
# Enteros mayores que cero; si faltan, valen 30 minutos y 12 horas.
# El frontend renueva el acceso solo con el refresco: la sesión dura lo que
# dure el refresco. Para probar la renovación en local: JWT_ACCESS_MINUTES=1
# SGDE-92: cada renovación cambia el refresco (el anterior deja de servir) pero
# no alarga la sesión: sigue terminando JWT_REFRESH_HOURS después del login.
# Al cerrar sesión el refresco se invalida; el acceso sirve hasta que vence.
JWT_ACCESS_MINUTES=30
JWT_REFRESH_HOURS=12

# --- Límite de intentos por IP (SGDE-112) -------------------------------------
# Formato "<número>/<second|minute|hour|day>". Si faltan: 5/min, 30/min y 10/hour.
# Pasado el límite, el API responde 429 "Hiciste muchos intentos seguidos".
# THROTTLE_LOGIN=5/min
# THROTTLE_RENOVAR_TOKEN=30/min
# THROTTLE_REGISTRO=10/hour
# Proxies delante de Django, para saber la IP real del cliente en los límites
# de intentos. Si no la defines: 0 con DEBUG=True (local) y 1 sin DEBUG (Render).
# NUM_PROXIES=1

# --- Solo producción (Render). No definir en local ----------------------------
# URL completa de Postgres; si existe, tiene prioridad sobre DB_*.
# DATABASE_URL=
# URL del frontend en Vercel; se agrega a los orígenes CORS permitidos.
# FRONTEND_URL=

# --- Correos (recuperar contraseña SGDE-96, bienvenida SGDE-111) -------------
# En local no definas nada: los correos se muestran en la terminal del backend.
# En producción (DEBUG=False) sin EMAIL_BACKEND NO se envía nada: queda un error en el
# log, sin el contenido, y el aviso sgde.W001 al arrancar. Nunca se usa la consola.
# En producción, con una cuenta de Gmail (necesita una "contraseña de aplicación"):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=SGDE <correo@gmail.com>
# Minutos que dura el enlace para crear una contraseña nueva (por defecto 60).
# RECUPERAR_CLAVE_MINUTOS=60
# Los enlaces de los correos apuntan a FRONTEND_URL (en local, http://localhost:5173;
# en producción es obligatoria: sin ella, aviso sgde.W002).
# Los correos se envían en un hilo aparte, fuera de la petición. Para depurar en
# local se puede apagar con CORREOS_EN_SEGUNDO_PLANO=False.

# Proxies delante del backend: 1 en Render (valor por defecto). Los límites de
# intentos cuentan por la IP que agrega el proxy. En local, sin proxy, usa 0.
# NUM_PROXIES=1

# --- Datos de demostración (comando seed_demo) --------------------------------
# Contraseñas de admin, cliente_demo y proveedor_demo. Si se omiten, usa
# valores por defecto SOLO para desarrollo.
SEED_ADMIN_PASSWORD=
SEED_CLIENTE_PASSWORD=
SEED_PROVEEDOR_PASSWORD=
