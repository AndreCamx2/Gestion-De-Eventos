# Variables del frontend (Vite). Para "npm run dev" copia este archivo a
# frontend/.env.local:   Copy-Item .env.example .env.local
# (.env.local NO se sube a GitHub.)

# URL del backend tal como la ve el navegador.
VITE_API_URL=http://localhost:8000/api

# Recuperar contraseña por correo (SGDE-96). Apagado mientras el backend no tenga
# una cuenta de correo configurada: el login no muestra "¿La olvidaste?".
# VITE_RECUPERAR_CLAVE=true
